{
  "name": "ai-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,reminders \"next dev --hostname 127.0.0.1\" \"npm run worker\"",
    "dev:web": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "concurrently -k -n web,reminders \"next start --hostname 127.0.0.1\" \"npm run worker\"",
    "worker": "node --env-file-if-exists=.env.local --import tsx server/worker.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "next lint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "collect:scholarships": "node --env-file-if-exists=.env.local --import tsx server/collect-scholarships.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@libsql/client": "^0.18.0",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.50.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
