ANTHROPIC_API_KEY=
# AI 분석·컨설팅 모델. 비워 두면 기본값 claude-opus-5-5를 사용합니다. 비용을 줄이려면 claude-sonnet-5-5 등으로 바꿀 수 있습니다. 날짜 접미사 없이 모델 ID만 적습니다.
ANTHROPIC_MODEL=claude-opus-5-5
DATABASE_URL=file:data/campus.db
DATABASE_AUTH_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_URL=http://localhost:3000
REMINDER_POLL_MS=5000

# ── 실시간 장학금·채용 공고(선택) ─────────────────────────────────────────────
# 비워 두면 해당 소스만 "키 필요"로 표시되고, 키 없이 동작하는 소스(국민대 공지·한국장학재단 공지·드림스폰·원티드·링커리어·잡알리오)는 그대로 나옵니다.
# 발급·검증 방법은 docs/SOURCES.md 참고. 키는 서버에서만 쓰이며 브라우저로 전달되지 않습니다.
# 사람인 채용 API: https://oapi.saramin.co.kr 에서 회원 가입 후 "API 키 발급" 신청. 승인 소요 시간: 확인 필요.
SARAMIN_API_KEY=
# 공공데이터포털(data.go.kr) "한국장학재단_학자금지원정보(대학생)" 활용신청 후 받는 일반 인증키(Encoding·Decoding 아무 쪽이나). 파일데이터 API는 보통 자동 승인(확인 필요).
DATA_GO_KR_SERVICE_KEY=
# 위 데이터셋의 요청 주소. 비워 두면 2026-09-10 판 기본 주소를 씁니다. 데이터가 갱신되어 uddi가 바뀌면 포털의 Swagger 화면에 나온 주소로 바꿉니다.
KOSAF_API_URL=
# 고용24(구 워크넷) 채용정보 OpenAPI 인증키: https://www.work24.go.kr 의 OpenAPI 메뉴에서 신청. 채용정보 API는 신청 자격·심사가 있을 수 있음(확인 필요).
WORK24_API_KEY=
# 온통청년 청년정책 OpenAPI 인증키: https://www.youthcenter.go.kr 로그인 후 OpenAPI 메뉴에서 신청. 승인 소요 시간: 확인 필요.
YOUTHCENTER_API_KEY=
